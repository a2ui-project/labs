{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2ui.org/conformance/craft/conformance_schema.json",
  "title": "Craft Conformance Test Suite Schema",
  "description": "JSON schema validating the Craft conformance test suites in craft/.",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/CraftTestCase"
  },
  "$defs": {
    "CraftTestCase": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {
          "enum": [
            "parse_library",
            "parse_data",
            "resolve_names",
            "decode_library",
            "encode_library",
            "decode_data",
            "encode_data"
          ],
          "description": "The conformance test action to perform."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "parse_library"
              }
            },
            "required": ["action"]
          },
          "then": {
            "$ref": "#/$defs/CraftParseLibraryTest"
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "parse_data"
              }
            },
            "required": ["action"]
          },
          "then": {
            "$ref": "#/$defs/CraftParseDataTest"
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "resolve_names"
              }
            },
            "required": ["action"]
          },
          "then": {
            "$ref": "#/$defs/CraftResolveNamesTest"
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "decode_library"
              }
            },
            "required": ["action"]
          },
          "then": {
            "$ref": "#/$defs/CraftDecodeLibraryTest"
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "encode_library"
              }
            },
            "required": ["action"]
          },
          "then": {
            "$ref": "#/$defs/CraftEncodeLibraryTest"
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "decode_data"
              }
            },
            "required": ["action"]
          },
          "then": {
            "$ref": "#/$defs/CraftDecodeDataTest"
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "encode_data"
              }
            },
            "required": ["action"]
          },
          "then": {
            "$ref": "#/$defs/CraftEncodeDataTest"
          }
        }
      ]
    },
    "CraftFeatureTags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^F-CRAFT-[A-Z0-9]+-[0-9]{2}$"
      },
      "description": "Feature registry IDs (features.yaml) exercised by this test case."
    },
    "CraftCaseMetadata": {
      "type": "object",
      "required": ["name", "action", "features", "description"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "features": {
          "$ref": "#/$defs/CraftFeatureTags"
        },
        "action": {
          "type": "string"
        }
      },
      "description": "The fields every Craft test case has."
    },
    "CraftSource": {
      "type": "string",
      "description": "A library file or a data file in the Craft text format."
    },
    "CraftLibrarySources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/CraftSource"
      },
      "description": "Template libraries: library name (dotted) -> library source."
    },
    "CraftPath": {
      "type": "array",
      "items": {
        "type": ["string", "integer"]
      },
      "description": "Argument names, map keys and list indexes from the root node of an expansion."
    },
    "CraftParseError": {
      "type": "object",
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "description": "The source is rejected; line, when given, is the 1-based line the engine reports."
    },
    "CraftParseLibraryTest": {
      "type": "object",
      "description": "Parses source as a library file and compares its canonical JSON form, or expects a rejection.",
      "$ref": "#/$defs/CraftCaseMetadata",
      "properties": {
        "action": {
          "const": "parse_library"
        },
        "source": {
          "$ref": "#/$defs/CraftSource"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/CraftSource"
          },
          "description": "Several sources, each of which must meet the expectation."
        },
        "expect": {
          "type": "object",
          "properties": {
            "library": {},
            "error": {
              "$ref": "#/$defs/CraftParseError"
            }
          },
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1
        }
      },
      "required": ["expect"],
      "unevaluatedProperties": false,
      "oneOf": [
        {
          "required": ["source"]
        },
        {
          "required": ["sources"]
        }
      ]
    },
    "CraftParseDataTest": {
      "type": "object",
      "description": "Parses source as a data file and compares its canonical JSON form, or expects a rejection.",
      "$ref": "#/$defs/CraftCaseMetadata",
      "properties": {
        "action": {
          "const": "parse_data"
        },
        "source": {
          "$ref": "#/$defs/CraftSource"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/CraftSource"
          },
          "description": "Several sources, each of which must meet the expectation."
        },
        "expect": {
          "type": "object",
          "properties": {
            "data": {},
            "error": {
              "$ref": "#/$defs/CraftParseError"
            }
          },
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1
        }
      },
      "required": ["expect"],
      "unevaluatedProperties": false,
      "oneOf": [
        {
          "required": ["source"]
        },
        {
          "required": ["sources"]
        }
      ]
    },
    "CraftPrimitiveNames": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "description": "Primitive libraries: library name -> primitive names."
    },
    "CraftResolution": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "library": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "kind": {
              "enum": ["template", "primitive"]
            }
          },
          "required": ["library", "name", "kind"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "enum": ["notFound", "notQualified", "notImported", "notExported"]
            }
          },
          "required": ["error"],
          "additionalProperties": false
        }
      ]
    },
    "CraftNameQuery": {
      "type": "object",
      "required": ["query"],
      "properties": {
        "query": {
          "enum": [
            "resolve",
            "resolveImported",
            "catalogComponent",
            "functionKey",
            "visibleFunctions",
            "visibleNames"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "query": {
                "const": "resolve"
              }
            },
            "required": ["query"]
          },
          "then": {
            "properties": {
              "from": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "excluding": {
                "type": "string"
              },
              "expect": {
                "$ref": "#/$defs/CraftResolution"
              }
            },
            "required": ["from", "name", "expect"]
          }
        },
        {
          "if": {
            "properties": {
              "query": {
                "const": "resolveImported"
              }
            },
            "required": ["query"]
          },
          "then": {
            "properties": {
              "from": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "expect": {
                "$ref": "#/$defs/CraftResolution"
              }
            },
            "required": ["from", "name", "expect"]
          }
        },
        {
          "if": {
            "properties": {
              "query": {
                "const": "catalogComponent"
              }
            },
            "required": ["query"]
          },
          "then": {
            "properties": {
              "catalog": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "expect": {
                "$ref": "#/$defs/CraftResolution"
              }
            },
            "required": ["catalog", "name", "expect"]
          }
        },
        {
          "if": {
            "properties": {
              "query": {
                "const": "functionKey"
              }
            },
            "required": ["query"]
          },
          "then": {
            "properties": {
              "from": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "functions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "expect": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": ["string", "null"]
                  }
                },
                "required": ["key"],
                "additionalProperties": false
              }
            },
            "required": ["from", "name", "functions", "expect"]
          }
        },
        {
          "if": {
            "properties": {
              "query": {
                "const": "visibleFunctions"
              }
            },
            "required": ["query"]
          },
          "then": {
            "properties": {
              "from": {
                "type": "string"
              },
              "functions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "expect": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": ["from", "functions", "expect"]
          }
        },
        {
          "if": {
            "properties": {
              "query": {
                "const": "visibleNames"
              }
            },
            "required": ["query"]
          },
          "then": {
            "properties": {
              "from": {
                "type": "string"
              },
              "expect": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/CraftResolution"
                }
              }
            },
            "required": ["from", "expect"]
          }
        }
      ],
      "unevaluatedProperties": false,
      "description": "A question about names; see craft_libraries_and_names.yaml."
    },
    "CraftResolveNamesTest": {
      "type": "object",
      "description": "Registers libraries and checks the answers to questions about names.",
      "$ref": "#/$defs/CraftCaseMetadata",
      "properties": {
        "action": {
          "const": "resolve_names"
        },
        "libraries": {
          "$ref": "#/$defs/CraftLibrarySources"
        },
        "primitives": {
          "$ref": "#/$defs/CraftPrimitiveNames"
        },
        "queries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/CraftNameQuery"
          }
        }
      },
      "required": ["queries"],
      "unevaluatedProperties": false
    },
    "CraftHex": {
      "type": "string",
      "description": "Bytes as pairs of hex digits separated by whitespace, with # comments to the end of the line."
    },
    "CraftBlobError": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$"
        },
        "offset": {
          "type": ["integer", "null"]
        },
        "version": {
          "type": ["integer", "null"]
        },
        "tag": {
          "type": ["integer", "null"]
        }
      },
      "required": ["kind"],
      "additionalProperties": false,
      "description": "A decoding error; an omitted field is null."
    },
    "CraftDecodeLibraryTest": {
      "type": "object",
      "description": "Decodes hex as a library blob.",
      "$ref": "#/$defs/CraftCaseMetadata",
      "properties": {
        "action": {
          "const": "decode_library"
        },
        "hex": {
          "$ref": "#/$defs/CraftHex"
        },
        "expect": {
          "type": "object",
          "properties": {
            "library": {},
            "source": {
              "$ref": "#/$defs/CraftSource"
            },
            "error": {
              "$ref": "#/$defs/CraftBlobError"
            }
          },
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1
        }
      },
      "required": ["hex", "expect"],
      "unevaluatedProperties": false
    },
    "CraftEncodeLibraryTest": {
      "type": "object",
      "description": "Parses source as a library file and encodes it.",
      "$ref": "#/$defs/CraftCaseMetadata",
      "properties": {
        "action": {
          "const": "encode_library"
        },
        "source": {
          "$ref": "#/$defs/CraftSource"
        },
        "expect": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "hex": {
                  "$ref": "#/$defs/CraftHex"
                },
                "decoded": {
                  "type": "object",
                  "properties": {
                    "library": {}
                  },
                  "required": ["library"],
                  "additionalProperties": false
                }
              },
              "required": ["hex"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "error": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": false,
                  "maxProperties": 0
                }
              },
              "required": ["error"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["source", "expect"],
      "unevaluatedProperties": false
    },
    "CraftDecodeDataTest": {
      "type": "object",
      "description": "Decodes hex as a data blob.",
      "$ref": "#/$defs/CraftCaseMetadata",
      "properties": {
        "action": {
          "const": "decode_data"
        },
        "hex": {
          "$ref": "#/$defs/CraftHex"
        },
        "expect": {
          "type": "object",
          "properties": {
            "data": {},
            "error": {
              "$ref": "#/$defs/CraftBlobError"
            }
          },
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1
        }
      },
      "required": ["hex", "expect"],
      "unevaluatedProperties": false
    },
    "CraftEncodeDataTest": {
      "type": "object",
      "description": "Parses source as a data file and encodes it.",
      "$ref": "#/$defs/CraftCaseMetadata",
      "properties": {
        "action": {
          "const": "encode_data"
        },
        "source": {
          "$ref": "#/$defs/CraftSource"
        },
        "expect": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "hex": {
                  "$ref": "#/$defs/CraftHex"
                },
                "decoded": {
                  "type": "object",
                  "properties": {
                    "data": {}
                  },
                  "required": ["data"],
                  "additionalProperties": false
                }
              },
              "required": ["hex"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "error": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": false,
                  "maxProperties": 0
                }
              },
              "required": ["error"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["source", "expect"],
      "unevaluatedProperties": false
    }
  }
}
