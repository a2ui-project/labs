load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "room",
    srcs = [
        "room.go",
        "templates.go",
        "yjs_a2ui.go",
    ],
    importpath = "github.com/a2ui-project/labs/samples/yjs-a2ui/room",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_reearth_ygo//crdt",
        "@com_github_reearth_ygo//provider/websocket",
    ],
)

go_test(
    name = "room_test",
    srcs = ["room_test.go"],
    embed = [":room"],
    deps = [
        "@com_github_gorilla_websocket//:websocket",
        "@com_github_reearth_ygo//crdt",
        "@com_github_reearth_ygo//sync",
    ],
)
