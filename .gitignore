# Build artifacts, caches, and local settings shared by most sub-projects.
# Sub-projects add their own .gitignore for anything specific to them.

# OS and editors
.DS_Store
.idea/
*.iml
*.swp

# Secrets
.env
.env.*
!.env.example

# Node.js
node_modules/
dist/
coverage/
*.tsbuildinfo
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/sdks

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Dart and Flutter
.dart_tool/
.flutter-plugins-dependencies
build/
