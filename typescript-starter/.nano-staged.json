{
  "packages/*/{package.json,tsconfig.json}": [
    "node ./bin/validate-publish-imports.mts --fix",
    "yarn sync:tsconfig-references"
  ],
  "**/*.{js,mjs,jsx,ts,tsx}": [
    "oxlint --fix --type-aware --quiet --no-error-on-unmatched-pattern",
    "npx --yes prettier@3.8.4 --write --ignore-unknown"
  ],
  "**/*.{md,json,yml,yaml}": "npx --yes prettier@3.8.4 --write --ignore-unknown"
}
